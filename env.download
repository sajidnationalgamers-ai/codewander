# ==============================
# CodeWander — Environment Variables
# Place this file inside: codewander/.env.local
# ==============================

# ── AI Idea Generator (Anthropic Claude) ──
# Get your free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MongoDB (for real database) ──
# Free cluster at: https://mongodb.com/atlas
# MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster.mongodb.net/codewander

# ── App URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
